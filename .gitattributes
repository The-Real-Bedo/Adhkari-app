# Normalise line endings so the platform runner files stop showing up as
# whole-file diffs. Without this, a checkout that introduced CRLF made all 89
# android/ios/linux/windows template files look fully rewritten.
* text=auto eol=lf

# Windows-only sources that MSVC is happiest reading as CRLF.
*.rc text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.mp3 binary
*.jks binary
*.keystore binary

# Xcode project files: keep them out of merge-conflict resolution attempts.
*.pbxproj -merge
